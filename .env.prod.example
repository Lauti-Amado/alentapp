# =============================================================================
# .env.prod.example
# Plantilla de variables de entorno para producción.
# Copiar a .env.prod y completar con los valores reales.
#
#   cp .env.prod.example .env.prod
#
# IMPORTANTE: .env.prod NUNCA debe commitearse al repositorio.
#             Añadirlo al .gitignore si no está ya.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos — PostgreSQL
# Estas variables son leídas directamente por la imagen postgres:16-alpine.
# -----------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=alentapp_db

# URL de conexión completa usada por Prisma (API).
# Formato: postgresql://<user>:<password>@db:5432/<dbname>
# El host 'db' es el nombre del servicio de PostgreSQL en docker-compose.prod.yml.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/alentapp_db

# -----------------------------------------------------------------------------
# API — Fastify
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Web — Vite (build-time arg)
# URL de la API accesible desde el NAVEGADOR del usuario final.
# NO usar la URL interna del contenedor (http://api:3000), sino la URL pública.
# Ejemplos:
#   http://localhost:3000      (desarrollo local o servidor expuesto directamente)
#   https://api.tudominio.com  (producción con dominio)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000